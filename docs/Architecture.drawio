<mxfile host="app.diagrams.net" modified="2026-08-30T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="FP4 Sparse TPU — Tiny Tapeout Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="15" width="950" height="35" as="geometry"/></mxCell>
        <mxCell id="clock_note" value="Single clock domain • clk = 10 MHz • SPI inputs synchronized internally • SCLK ≤ clk/6" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="245" y="60" width="760" height="42" as="geometry"/></mxCell>
        <mxCell id="host" value="Host / testbench&#xa;SPI master" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="135" height="72" as="geometry"/></mxCell>
        <mxCell id="spi" value="SPI receiver&#xa;16-bit frame&#xa;(receive-only)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="230" width="175" height="112" as="geometry"/></mxCell>
        <mxCell id="control" value="Control FSM&#xa;LOAD / RUN / STORE&#xa;row, col, step counters" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="220" width="200" height="132" as="geometry"/></mxCell>
        <mxCell id="mem_a" value="Activation memory A&#xa;3 rows × 8 INT8 values&#xa;16-bit pair read port" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="85" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="pe" value="FP4 processing element&#xa;activation select&#xa;shift-add product&#xa;14-bit accumulator" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="mem_b" value="Weight memory B&#xa;3 columns × 4 FP4 codes&#xa;5-bit code read port" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="425" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="result_mem" value="Result memory&#xa;3 × 3 × 14 bits" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985" y="225" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="result_mux" value="STORE read mux&#xa;row / col / byte" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985" y="385" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="output" value="uo_out[7:0]&#xa;selected result byte" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="985" y="520" width="190" height="64" as="geometry"/></mxCell>
        <mxCell id="ready" value="uio_out[1] = ready&#xa;sticky after final commit&#xa;cleared by reset or next RUN" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="425" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="legend" value="Solid arrows: data&#xa;Dashed arrows: control / address" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="435" width="175" height="62" as="geometry"/></mxCell>
        <mxCell id="summary" value="Per output: 4 accumulate cycles + 1 commit cycle. Nine row-major outputs use 45 compute cycles after RUN acceptance. The single PE and single-port operand memories avoid multi-PE read conflicts; larger tiling and cross-block accumulation remain host-side." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="175" y="630" width="900" height="76" as="geometry"/></mxCell>
        <mxCell id="e_host_spi" value="MOSI / CS / SCLK" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="host" target="spi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_spi_control" value="instruction[15:0]&#xa;one clk pulse" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="spi" target="control"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_control_a" value="LOAD A write / RUN address" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="control" target="mem_a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_control_b" value="LOAD B write / RUN address" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="control" target="mem_b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_a_pe" value="activation pair [15:0]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mem_a" target="pe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_b_pe" value="weight code [4:0]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mem_b" target="pe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_control_pe" value="pe_we / pe_clr / dense" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="control" target="pe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pe_result" value="14-bit accumulated result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pe" target="result_mem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_control_result" value="commit + write row/col" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="control" target="result_mem"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="195"/><mxPoint x="1080" y="195"/></Array></mxGeometry></mxCell>
        <mxCell id="e_result_mux" value="selected 14-bit result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="result_mem" target="result_mux"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_control_mux" value="STORE row/col/byte" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="control" target="result_mux"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="665" y="405"/><mxPoint x="955" y="405"/></Array></mxGeometry></mxCell>
        <mxCell id="e_mux_output" value="8-bit data" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="result_mux" target="output"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_control_ready" value="status" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="control" target="ready"><mxGeometry relative="1" as="geometry"/></mxCell>
