<mxfile host="app.diagrams.net" type="device">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="FP4 Sparse Mini-TPU — Architecture (Tiny Tapeout 1x2 tile, time-multiplexed single PE)" style="text;html=1;fontSize=17;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="820" height="30" as="geometry" />
        </mxCell>

        <mxCell id="host" value="SPI Host&#10;(RP2040 / testbench)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="spi" value="SPI slave (single clk domain)&#10;synchronized MOSI / CS / SCLK&#10;16-bit LSB-first, receive-only&#10;SCLK &amp;lt;= clk/6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="290" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ctrl" value="Control unit / sequencer&#10;LOAD / RUN / STORE&#10;(cur_row, cur_col, step) walks&#10;all 9 outputs, ~45 cycles/RUN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="270" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="mema" value="Memory A (activations)&#10;3 rows x 8 INT8&#10;SINGLE port: addr = (row, pair)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="memb" value="Memory B (weights)&#10;3 cols x 4 codes {select, e2m1}&#10;SINGLE port: addr = (col, pair)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="720" y="460" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pe" value="ONE PE, time-multiplexed&#10;shift-add MAC, NO multiplier&#10;same datapath as before, reused&#10;9x/RUN instead of 9 spatial copies&#10;14-bit exact accumulator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="720" y="260" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="resmem" value="Result memory&#10;9 x 14-bit (row-major)&#10;written once per output, on commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="580" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="mux" value="Result mux&#10;STORE {row, col, byte_sel}&#10;14-bit acc -&gt; 2 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="680" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uo" value="uo_out[7:0]&#10;result byte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="980" y="685" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="ui[0] MOSI, ui[1] CS, ui[2] SCLK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="host" target="spi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="instruction[15:0]&#10;(1-cycle pulse)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="spi" target="ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="write / single-port read&#10;addr = (cur_row, step)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.75;exitY=0;" edge="1" parent="1" source="ctrl" target="mema">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="write / single-port read&#10;addr = (cur_col, step)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.75;exitY=1;" edge="1" parent="1" source="ctrl" target="memb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="a_in: ONE INT8 pair (16b)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mema" target="pe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="b_in: ONE 5-bit code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="memb" target="pe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="pe_we / pe_clr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="ctrl" target="pe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="c_out: 14-bit (write on commit)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pe" target="resmem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8b" value="write addr = (cur_row, cur_col)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="ctrl" target="resmem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="read addr = (store_row, store_col)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="resmem" target="mux">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="mux" target="uo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="ready -&gt; uio[1]&#10;(sticky until next RUN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.25;exitY=1;dashed=1;" edge="1" parent="1" source="ctrl">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="Why one PE instead of nine: RUN's ~45-cycle latency (9 outputs x 4 accumulate + 1 commit) is about 1.3% of the &gt;=3456 clk cycles needed to transfer all 36 operand instructions at SCLK &lt;= clk/6 — spatial parallelism bought nothing but area. Removing it also removes the reason the memories needed 3 concurrent read ports (the old skewed wavefront): now one port each. Numerics are byte-for-byte unchanged — same E2M1 shift-add PE datapath (see pe.v), same 1:2 sparsity, same K=8/dense K=4, same exact 14-bit accumulation; only the spatial-vs-temporal execution strategy changed. Measured: 32.8% GPL / 28.6% effective on 2x2 tiles -> 70.1% GPL / 60.6% effective on 1x2, both under the fleet's 65% safe-placement rule; area fell ~47% (38889 -&gt; 20760 sq-um-equivalent) vs the 9-PE parallel array." style="text;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="640" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
